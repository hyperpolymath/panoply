;;
;; Panoply is a library, not a Groove provider. Port 0, no surfaces.
;; Spec lives in metadatastician/groove (working draft). Do not enable
;; REST/gRPC/etc. until a process exists to advertise.
(groove-manifest
  (version "1.0")
  (service "panoply")
  (service-version "0.1.0")
  (port 0)
  (api-surfaces
    (rest      (enabled false) (path "/api/v1"))
    (grpc      (enabled false) (port-offset 1))
    (graphql   (enabled false) (path "/graphql"))
    (websocket (enabled false) (path "/ws"))
    (sse       (enabled false) (path "/events"))
    (groove    (enabled false) (path "/.well-known/groove")))
  (health "/health")
  (capabilities ())
  (dependencies ()))
