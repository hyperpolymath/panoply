### [META]
id: "machine-readable-pillar"
level: 1
parent: "../0-AI-MANIFEST.deed"

---
### [AI_MANIFEST]
description: |
  Registry for all machine-readable metadata, policies, and internal
  automation scripts.

canonical_locations:
  state: "descriptiles/STATE.deed"
  meta: "descriptiles/META.deed"
  ecosystem: "descriptiles/ECOSYSTEM.deed"
  agentic: "descriptiles/AGENTIC.deed"
  neurosym: "descriptiles/NEUROSYM.deed"
  playbook: "descriptiles/PLAYBOOK.deed"
  clade: "descriptiles/CLADE.deed"
  anchors: "descriptiles/anchors/"
  policies: "policies/"
  ai_configs: "ai/"
  compliance: "compliance/"
  scripts: "scripts/"

invariants:
  - "Metadata files MUST follow a2ml format"
  - "Internal automation MUST live in scripts/ subfolder"
