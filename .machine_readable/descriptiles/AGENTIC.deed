(repo-deed
  :schema-version "1.0.0"
  :canonical-name "panoply-agentic"
  :repo-uuid #uuid"c6ce29e7-e7bf-8da3-9130-1841ac24bde8"
  :beholding-chora #uuid"0889b37b-defb-831f-973c-e119500db00e"
  :last-updated "2026-09-20"
  (agent-permissions
    :can-edit-source true
    :can-edit-tests true
    :can-edit-docs true
    :can-edit-config true
    :can-create-files true)
  (maintenance-integrity
    :fail-closed true
    :require-evidence-per-step true
    :allow-silent-skip false)
