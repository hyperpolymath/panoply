(repo-deed
  :schema-version "1.0.0"
  :canonical-name "panoply-agentic"
  :repo-uuid #u5"hyperpolymath/panoply"
  :beholding-chora #u5"estate/chora"
  :last-updated "2026-09-20"
  (agent-permissions
    :can-edit-source true
    :can-edit-tests true
    :can-edit-docs true
    :can-edit-config true
    :can-create-files true)
  (maintenance-integrity
    :fail-closed true
    :require-evidence-per-step true
    :allow-silent-skip false)
  (methodology
    :instructions-dir ".machine_readable/bot_directives/"
    :default-mode "hybrid"))
