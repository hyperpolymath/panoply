# SPDX-License-Identifier: MPL-2.0
# Activate development environment
# Install direnv: https://direnv.net/

# Load .tool-versions if asdf is available
if has asdf; then
  use asdf
fi

# Load Guix shell if a Guix manifest exists (Nix is deprecated)
if has guix && { [ -f build/guix.scm ] || [ -f guix.scm ]; }; then
  use guix
fi

# Project environment variables
export PROJECT_NAME="Panoply"
export RSR_TIER="infrastructure"

# Source .env if it exists (gitignored)
dotenv_if_exists
