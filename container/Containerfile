# Canonical container path (stapeln). Same as build/Containerfile:
# Zig FFI tests only. Panoply is not an HTTP service — no EXPOSE 8080.

FROM cgr.dev/chainguard/wolfi-base:latest AS builder
WORKDIR /src
RUN apk add --no-cache curl tar xz
RUN curl -fsSL -o /tmp/zig.tar.xz \
      https://ziglang.org/download/0.15.1/zig-x86_64-linux-0.15.1.tar.xz \
    && tar -xJf /tmp/zig.tar.xz -C /opt \
    && ln -s /opt/zig-x86_64-linux-0.15.1/zig /usr/local/bin/zig
COPY src/interface/ffi /src/src/interface/ffi
WORKDIR /src/src/interface/ffi
RUN zig build test

FROM cgr.dev/chainguard/wolfi-base:latest
LABEL org.opencontainers.image.title="Panoply" \
      org.opencontainers.image.description="Envelope-first language discipline (library; FFI tests)" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/panoply" \
      org.opencontainers.image.licenses="MPL-2.0"
COPY container/entrypoint.sh /app/entrypoint.sh
USER nonroot
WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]
# Default: print honesty, then exit 0 (no daemon).
CMD ["true"]
