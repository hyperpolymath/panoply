# Dev Container image for Panoply
# Base: Chainguard Wolfi (minimal, supply-chain-secure)
# Build: podman build -t Panoply-dev -f .devcontainer/Containerfile .

FROM cgr.dev/chainguard/wolfi-base:latest

# Install common development tools + Zig 0.15.1 (official tarball)
RUN apk update && apk add --no-cache \
    bash \
    curl \
    git \
    openssh-client \
    ca-certificates \
    build-base \
    posix-libc-utils \
    shadow \
    tar \
    xz \
    && rm -rf /var/cache/apk/*
RUN curl -fsSL -o /tmp/zig.tar.xz \
      https://ziglang.org/download/0.15.1/zig-x86_64-linux-0.15.1.tar.xz \
    && tar -xJf /tmp/zig.tar.xz -C /opt \
    && ln -s /opt/zig-x86_64-linux-0.15.1/zig /usr/local/bin/zig

# Create non-root dev user (matches devcontainer.json remoteUser)
RUN groupadd -g 1000 nonroot || true \
    && useradd -m -u 1000 -g 1000 -s /bin/bash nonroot || true

# Set workspace directory
WORKDIR /workspaces/Panoply

# Default shell
ENV SHELL=/bin/bash

USER nonroot
